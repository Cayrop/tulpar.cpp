# CORRECTED 2026-08-24 (Phase-2A full run): was "build/bin/llama-server".
# Production validated with build-p3 during Phase-1B restore (RESTORE_OK,
# health OK, 6/6 semantic match). build/bin/llama-server remains fallback only.
BINARY_PATH="<REPO_ROOT>/build-p3/bin/llama-server"
MODEL_PATH="/home/gencer/models/qwen38/Qwen3.8-27B-UD-Q2_K_XL.gguf"
ALIAS="Qwen3.8-27b"

# Context & GPU
CTX_SIZE=65536
GPU_LAYERS=999
LOAD_MODE="mmap"
FLASH_ATTN="on"
CACHE_TYPE_K="q4_0"
CACHE_TYPE_V="q4_0"

# Sampling
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0

# Server
HOST="0.0.0.0"
PORT=8080
METRICS="--metrics"
TOOLS="--tools all"
CHAT_TEMPLATE_KWARGS='{"preserve_thinking": true}'

# MTP / Speculative Decoding
SPEC_TYPE="draft-mtp"
SPEC_DRAFT_N_MAX=4
SPEC_DRAFT_P_MIN=0.8

# Threads
THREADS=8

# Cache prompt
CACHE_PROMPT="--cache-prompt"
CTX_CHECKPOINTS=4

# Environment
# CORRECTED 2026-08-24 (Phase-2A addendum): GGML_CUDA_DISABLE_GRAPHS=1 removed/commented.
# Evidence: real production process ran graphs-enabled (restore log: "graphs reused = 3291").
